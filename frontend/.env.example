# 서버 컴포넌트가 백엔드를 호출할 주소 (프로덕션은 pm2 env에서 :8082로 주입)
BACKEND_URL=http://127.0.0.1:8000

# 네모네 통합 인증 — 모든 서비스가 같은 Supabase 프로젝트/쿠키(.nemoneai.com)를 공유한다.
# 아래 두 값은 클라이언트 번들에 인라인되는 공개키라 비밀정보가 아님(맛매치/PACE와 동일 값).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 로그인/프로필 편집을 담당하는 통합 인증 센터
NEXT_PUBLIC_AUTH_URL=https://auth.nemoneai.com
